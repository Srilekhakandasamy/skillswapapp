# SkillSwap Backend Environment Configuration
# For local development with zero setup, leave as is (falls back to in-memory MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/skillswap

# For MongoDB Atlas cloud connection:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillswap?retryWrites=true&w=majority

JWT_SECRET=SkillSwap_JWT_2026_Secure_Key
PORT=5000
